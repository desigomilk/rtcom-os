generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserRole {
  ERP_ADMIN
  PLANT_STAFF
  FARM_STAFF
  DELIVERY_BOY
}

enum BatchStatus {
  AT_FARM
  IN_TRANSIT
  AT_PLANT
}

// A barrel's full round trip: filled at farm -> trucked to plant -> emptied
// into a chiller -> trucked back empty -> ready to fill again at (possibly a
// different) farm. This is the accountability loop the business explicitly
// called out as a recurring problem ("kitne barrel gaye, kitne wapas aaye").
enum BarrelStatus {
  AT_FARM_EMPTY
  AT_FARM_FILLED
  IN_TRANSIT_TO_PLANT
  AT_PLANT_EMPTIED
  IN_TRANSIT_TO_FARM
}

enum ContainerType {
  BOTTLE
  BARREL
  JAR
}

enum ContainerStatus {
  FILLED
  IN_TRANSIT
  DELIVERED
  RETURNED
  LOST
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
}

enum DeliveryExceptionType {
  PAUSE
  EXTRA
}

enum DeliveryStopStatus {
  PENDING
  COMPLETE
  PARTIAL
  ISSUE
}

enum DeliveryScanType {
  DELIVERED
  RETURNED_EMPTY
}

enum PaymentMethod {
  UPI
  QR
  CASH
  BANK
}

enum PenaltyType {
  UNRETURNED_BOTTLE_DAILY
  LOST_BOTTLE
  LOST_BARREL
  AMC
}

enum DeviceType {
  RTCOM_1A // chiller/cold-room thermometer
  RTCOM_1B // master barrel GPS+temp tracker
  RTCOM_1C // customer chiller monitor
  RTCOM_2A // mask/uniform/SOP compliance camera
  RTCOM_2B // Milkofit adulteration test camera
  RTCOM_2C // bottle-counting camera
  RTCOM_3A // TICC double-jacket barrel (passive, no telemetry)
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  ERROR
}

enum MessageChannel {
  WHATSAPP
  VOICE_CALL
}

enum IntentStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
}

enum LeadSource {
  WHATSAPP
  CALL
  REFERRAL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalSourceType {
  MANUAL
  INVOICE
  PAYMENT
  PENALTY
  EXPENSE
  OPENING_BALANCE
}

// ---------- Users & Auth ----------

model User {
  id               String   @id @default(cuid())
  name             String
  phone            String   @unique
  passwordHash     String
  role             UserRole
  refreshTokenHash String?
  externalId       String?  @unique // idempotency key for external data import
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  farmMilkEntries      FarmMilkEntry[]                @relation("EnteredBy")
  plantReceipts        PlantReceipt[]                 @relation("ReceivedBy")
  bottlingRuns         BottlingRun[]                  @relation("RunBy")
  deliveryLogs         DeliveryLog[]                  @relation("DeliveryBoy")
  handedOverLogs       DeliveryLog[]                  @relation("HandedOverFrom")
  emptyContainerRecons EmptyContainerReconciliation[] @relation("ReconDeliveryBoy")
  qrReassignments      ContainerQrReassignment[]      @relation("ReassignedBy")
  assignedLeads        Lead[]                         @relation("AssignedTo")
  routeAssignments     RouteAssignment[]              @relation("RouteAssignmentDeliveryBoy")
}

// ---------- Geography / Routes ----------

model City {
  id   String @id @default(cuid())
  name String @unique

  areas Area[]
}

model Area {
  id     String @id @default(cuid())
  name   String
  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  routes Route[]
  leads  Lead[]

  @@unique([cityId, name])
}

model Route {
  id     String  @id @default(cuid())
  name   String
  code   String  @unique
  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id])

  stops       RouteStop[]
  customers   Customer[]
  assignments RouteAssignment[]
}

// Which delivery boy owns a route on a given day. A mid-route handover (backup
// rider takes over) just repoints deliveryBoyId — the DeliveryLogs already
// submitted keep their original deliveryBoyId, and new ones from the backup
// rider record handedOverFromDeliveryBoyId so the handover is traceable.
model RouteAssignment {
  id            String   @id @default(cuid())
  routeId       String
  route         Route    @relation(fields: [routeId], references: [id])
  deliveryBoyId String
  deliveryBoy   User     @relation("RouteAssignmentDeliveryBoy", fields: [deliveryBoyId], references: [id])
  date          DateTime @db.Date
  createdAt     DateTime @default(now())

  @@unique([routeId, date])
}

// ---------- Farm -> Batch -> Plant traceability ----------

model Farm {
  id        String   @id @default(cuid())
  name      String
  ownerName String
  phone     String
  village   String
  createdAt DateTime @default(now())

  milkEntries   FarmMilkEntry[]
  chillerBlends ChillerBlend[]
  chillers      Chiller[]
  barrelsOnSite Barrel[]
}

model FarmMilkEntry {
  id                 String   @id @default(cuid())
  farmId             String
  farm               Farm     @relation(fields: [farmId], references: [id])
  litres             Decimal
  fat                Decimal
  snf                Decimal
  adulterationResult Json? // raw RTCOM 2B (Milkofit) result payload
  enteredById        String
  enteredBy          User     @relation("EnteredBy", fields: [enteredById], references: [id])
  timestamp          DateTime @default(now())
  batchId            String?
  batch              Batch?   @relation(fields: [batchId], references: [id])

  @@index([farmId, timestamp])
}

model Batch {
  id           String      @id @default(cuid())
  qrCode       String      @unique
  status       BatchStatus @default(AT_FARM)
  dispatchedAt DateTime?
  createdAt    DateTime    @default(now())
  barrelId     String?
  barrel       Barrel?     @relation(fields: [barrelId], references: [id])

  farmMilkEntries FarmMilkEntry[]
  plantReceipt    PlantReceipt?
  chillerBlends   ChillerBlend[]
}

// The physical, reusable barrel — QR-tagged once, trip after trip, distinct
// from Batch (one day's shipment record: which milk, which tests). Status
// plus its RTCOM 1B device's readings (temperature/GPS, via Device.barrelId)
// give live temp+location tracking without duplicating that state here.
model Barrel {
  id            String       @id @default(cuid())
  qrCode        String       @unique
  status        BarrelStatus @default(AT_FARM_EMPTY)
  currentFarmId String?
  currentFarm   Farm?        @relation(fields: [currentFarmId], references: [id])
  createdAt     DateTime     @default(now())

  batches Batch[]
  device  Device?
}

model PlantReceipt {
  id                 String   @id @default(cuid())
  batchId            String   @unique
  batch              Batch    @relation(fields: [batchId], references: [id])
  receivedAt         DateTime @default(now())
  fat                Decimal
  snf                Decimal
  adulterationResult Json?
  mismatchFlag       Boolean  @default(false)
  mismatchNotes      String?
  receivedById       String
  receivedBy         User     @relation("ReceivedBy", fields: [receivedById], references: [id])
}

// A chiller at a farm (farmId set — temperature-tracked only, no blending)
// or at the plant (farmId null — the ones that feed ChillerBlend/BottlingRun).
// RTCOM 1A units live on both; this is what tells the dashboard which is which.
model Chiller {
  id             String   @id @default(cuid())
  name           String
  capacityLitres Decimal
  farmId         String?
  farm           Farm?    @relation(fields: [farmId], references: [id])
  createdAt      DateTime @default(now())

  blends       ChillerBlend[]
  bottlingRuns BottlingRun[]
  device       Device?
}

// Tracks what % of a chiller's contents came from which farm/batch at a point in time,
// so a plant-level quality issue (or a client-facing trace lookup) can be traced back
// to source farms.
model ChillerBlend {
  id                  String   @id @default(cuid())
  chillerId           String
  chiller             Chiller  @relation(fields: [chillerId], references: [id])
  batchId             String
  batch               Batch    @relation(fields: [batchId], references: [id])
  farmId              String
  farm                Farm     @relation(fields: [farmId], references: [id])
  litres              Decimal
  percentContribution Decimal
  blendedAt           DateTime @default(now())

  @@index([chillerId, blendedAt])
}

// ---------- Bottling / Containers ----------

model BottlingRun {
  id           String   @id @default(cuid())
  chillerId    String
  chiller      Chiller  @relation(fields: [chillerId], references: [id])
  manualCount  Int
  cameraCount  Int?
  mismatchFlag Boolean  @default(false)
  runAt        DateTime @default(now())
  staffId      String
  staff        User     @relation("RunBy", fields: [staffId], references: [id])

  containers Container[]
}

// Generalizes the original "Bottle" model: D2C bottles, B2B barrels, and B2B jars
// are all containers distinguished by type/variant/seal color (RTCOM 2C reads seal
// color to tell variants apart).
model Container {
  id                String          @id @default(cuid())
  qrCode            String          @unique
  containerType     ContainerType
  variant           String // e.g. "Full Cream 500ml"
  sealColor         String?
  status            ContainerStatus @default(FILLED)
  bottlingRunId     String?
  bottlingRun       BottlingRun?    @relation(fields: [bottlingRunId], references: [id])
  currentCustomerId String?
  currentCustomer   Customer?       @relation(fields: [currentCustomerId], references: [id])
  createdAt         DateTime        @default(now())

  deliveryScans   DeliveryContainerScan[]
  qrReassignments ContainerQrReassignment[]
  penaltyCharges  PenaltyCharge[]
}

// Preserves the traceability chain when a physical container's QR tag is damaged
// and must be replaced.
model ContainerQrReassignment {
  id             String    @id @default(cuid())
  containerId    String
  container      Container @relation(fields: [containerId], references: [id])
  oldQrCode      String
  newQrCode      String
  reason         String
  reassignedAt   DateTime  @default(now())
  reassignedById String
  reassignedBy   User      @relation("ReassignedBy", fields: [reassignedById], references: [id])
}

// ---------- CRM / Leads ----------

model Lead {
  id                  String     @id @default(cuid())
  name                String
  phone               String
  source              LeadSource
  areaId              String?
  area                Area?      @relation(fields: [areaId], references: [id])
  status              LeadStatus @default(NEW)
  assignedToId        String?
  assignedTo          User?      @relation("AssignedTo", fields: [assignedToId], references: [id])
  notes               String?
  convertedCustomerId String?    @unique
  convertedCustomer   Customer?  @relation(fields: [convertedCustomerId], references: [id])
  createdAt           DateTime   @default(now())

  @@index([status])
}

// ---------- Customers, Delivery ----------

model Customer {
  id         String   @id @default(cuid())
  name       String
  // Not unique: one phone can legitimately cover multiple delivery profiles
  // (family members, or an old + new address during a move) — real imported
  // data confirmed this. Dedup on import uses phone + address/name instead.
  phone      String
  address    String
  areaLabel  String? // raw free-text locality from imported data, not a formal Area/City
  gpsLat     Decimal?
  gpsLng     Decimal?
  routeId    String?
  route      Route?   @relation(fields: [routeId], references: [id])
  // Idempotency key for re-running an external data import without duplicating rows.
  externalId String?  @unique
  createdAt  DateTime @default(now())

  currentContainers      Container[]
  routeStops             RouteStop[]
  subscriptions          Subscription[]
  deliveryDateExceptions DeliveryDateException[]
  invoices               Invoice[]
  penaltyCharges         PenaltyCharge[]
  messages               CustomerMessage[]
  convertedFromLead      Lead?
}

model RouteStop {
  id                String   @id @default(cuid())
  routeId           String
  route             Route    @relation(fields: [routeId], references: [id])
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id])
  sequence          Int // manually-set order
  sequenceOptimized Int? // optimizer-suggested order, once available
  plannedLat        Decimal?
  plannedLng        Decimal?

  deliveryLogs DeliveryLog[]

  @@unique([routeId, customerId])
  @@index([routeId, sequence])
}

// A customer's subscription is versioned: a quantity change creates a new row
// with a future effectiveFrom rather than mutating the existing one, so the
// "what was the plan on date X" question always has a clean answer. The
// "current" plan for a date is the latest row with effectiveFrom <= that date.
model Subscription {
  id                  String             @id @default(cuid())
  customerId          String
  customer            Customer           @relation(fields: [customerId], references: [id])
  dailyQuantityLitres Decimal
  ratePerLitre        Decimal            @default(0) // placeholder until real pricing data is imported
  status              SubscriptionStatus @default(ACTIVE)
  effectiveFrom       DateTime
  externalId          String?            @unique // idempotency key for external data import
  createdAt           DateTime           @default(now())

  @@index([customerId, effectiveFrom])
}

// Per-date calendar exception layered on top of the customer's current Subscription:
// PAUSE means zero delivery that date, EXTRA means the base quantity plus
// extraQuantityLitres. Keeping this keyed by customer+date (not by a specific
// Subscription row) means a pause scheduled before a later quantity change
// still applies correctly.
model DeliveryDateException {
  id                  String                @id @default(cuid())
  customerId          String
  customer            Customer              @relation(fields: [customerId], references: [id])
  date                DateTime              @db.Date
  type                DeliveryExceptionType
  extraQuantityLitres Decimal? // only set when type = EXTRA
  createdAt           DateTime              @default(now())

  @@unique([customerId, date])
}

model DeliveryLog {
  id            String             @id @default(cuid())
  routeStopId   String
  routeStop     RouteStop          @relation(fields: [routeStopId], references: [id])
  deliveryBoyId String
  deliveryBoy   User               @relation("DeliveryBoy", fields: [deliveryBoyId], references: [id])
  date          DateTime           @db.Date
  status        DeliveryStopStatus @default(PENDING)

  // Derived from the count of RETURNED_EMPTY DeliveryContainerScan rows for
  // this log — kept as a plain column for cheap display, not hand-entered.
  emptyContainersReturned Int @default(0)

  scannedLat Decimal?
  scannedLng Decimal?

  isManualOverride Boolean @default(false)
  overrideReason   String?
  overridePhotoUrl String?

  handedOverFromDeliveryBoyId String?
  handedOverFromDeliveryBoy   User?     @relation("HandedOverFrom", fields: [handedOverFromDeliveryBoyId], references: [id])
  handoverAt                  DateTime?

  clientEventId String    @unique // idempotency key from the offline mobile client
  scannedAt     DateTime?
  syncedAt      DateTime?
  createdAt     DateTime  @default(now())

  containerScans DeliveryContainerScan[]

  @@index([deliveryBoyId, date])
}

// One QR scan during a delivery visit — either a filled container handed to
// the customer (DELIVERED) or an empty one collected back (RETURNED_EMPTY).
// Same shape either way; `type` decides what happens to the container's
// status downstream.
model DeliveryContainerScan {
  id            String           @id @default(cuid())
  deliveryLogId String
  deliveryLog   DeliveryLog      @relation(fields: [deliveryLogId], references: [id])
  containerId   String
  container     Container        @relation(fields: [containerId], references: [id])
  type          DeliveryScanType @default(DELIVERED)
  scannedAt     DateTime         @default(now())
}

model EmptyContainerReconciliation {
  id             String   @id @default(cuid())
  deliveryBoyId  String
  deliveryBoy    User     @relation("ReconDeliveryBoy", fields: [deliveryBoyId], references: [id])
  date           DateTime @db.Date
  takenCount     Int
  deliveredCount Int
  returnedCount  Int
  discrepancy    Int
  createdAt      DateTime @default(now())

  @@unique([deliveryBoyId, date])
}

// ---------- Billing ----------

model Invoice {
  id          String        @id @default(cuid())
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  periodStart DateTime      @db.Date
  periodEnd   DateTime      @db.Date
  totalAmount Decimal
  status      InvoiceStatus @default(DRAFT)
  createdAt   DateTime      @default(now())

  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@unique([customerId, periodStart, periodEnd])
  @@index([customerId, periodStart])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  amount      Decimal
  kind        String // "milk" | "penalty" | "amc" | ...
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])
  amount      Decimal
  method      PaymentMethod
  referenceId String?
  paidAt      DateTime      @default(now())
}

model PenaltyCharge {
  id                 String      @id @default(cuid())
  customerId         String
  customer           Customer    @relation(fields: [customerId], references: [id])
  type               PenaltyType
  amount             Decimal
  appliedAt          DateTime    @default(now())
  notes              String?
  // Set only for UNRETURNED_BOTTLE_DAILY, so the daily batch job can dedupe —
  // one charge per container per customer per day, never more.
  relatedContainerId String?
  relatedContainer   Container?  @relation(fields: [relatedContainerId], references: [id])
  periodDate         DateTime?   @db.Date

  @@unique([customerId, type, relatedContainerId, periodDate])
}

// ---------- Devices / IoT ----------

model Device {
  id           String       @id @default(cuid())
  type         DeviceType
  serialNumber String       @unique
  location     String
  status       DeviceStatus @default(OFFLINE)
  lastSeenAt   DateTime?
  // SHA-256 of the device's issued API key — devices authenticate their own
  // readings webhook with this (not a user JWT), so a fast deterministic hash
  // is used instead of bcrypt, which is deliberately slow for password hashing.
  apiKeyHash   String?      @unique
  createdAt    DateTime     @default(now())

  // A temperature device (RTCOM 1A/1C) is mounted at one chiller; a GPS+temp
  // tracker (RTCOM 1B) rides on one barrel. Formal links (not just free-text
  // `location`) so the dashboard can query "latest reading for chiller X" /
  // "for barrel Y" directly instead of guessing from a label.
  chillerId String?  @unique
  chiller   Chiller? @relation(fields: [chillerId], references: [id])
  barrelId  String?  @unique
  barrel    Barrel?  @relation(fields: [barrelId], references: [id])

  readings DeviceReading[]
}

model DeviceReading {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id])
  payload    Json // temperature, SOP-breach flags, snapshot/video refs, etc.
  recordedAt DateTime @default(now())

  @@index([deviceId, recordedAt])
}

// ---------- Customer messaging / AI intent pipeline (WhatsApp + voice) ----------

model CustomerMessage {
  id         String         @id @default(cuid())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id])
  channel    MessageChannel
  direction  String // "IN" | "OUT"
  body       String // message text, or call transcript
  receivedAt DateTime       @default(now())

  parsedIntents ParsedIntent[]
}

model ParsedIntent {
  id         String          @id @default(cuid())
  messageId  String
  message    CustomerMessage @relation(fields: [messageId], references: [id])
  intentType String // e.g. "PAUSE_SUBSCRIPTION", "ADD_EXTRA"
  payload    Json
  status     IntentStatus    @default(PENDING_CONFIRMATION)
  createdAt  DateTime        @default(now())

  confirmation IntentConfirmation?
}

model IntentConfirmation {
  id                  String         @id @default(cuid())
  parsedIntentId      String         @unique
  parsedIntent        ParsedIntent   @relation(fields: [parsedIntentId], references: [id])
  confirmedAt         DateTime?
  confirmationChannel MessageChannel @default(WHATSAPP)
}

// ---------- Accounting (full double-entry general ledger) ----------
//
// Every money-moving event in the system — an issued invoice, a payment, a
// penalty, an expense — posts a balanced JournalEntry (sum(debit) ==
// sum(credit)) against this Chart of Accounts. Reports (ledger, cash book,
// trial balance, P&L, balance sheet) are all just queries over JournalLine,
// never a separately-maintained number, so they can never drift out of sync
// with the underlying transactions.

model ChartOfAccount {
  id        String           @id @default(cuid())
  code      String           @unique // e.g. "1000" Cash, "4000" Milk Sales Revenue
  name      String
  type      AccountType
  parentId  String?
  parent    ChartOfAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children  ChartOfAccount[] @relation("AccountHierarchy")
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())

  journalLines     JournalLine[]
  expenses         Expense[]     @relation("ExpenseAccount")
  paidFromExpenses Expense[]     @relation("PaidFromAccount")
}

model JournalEntry {
  id          String            @id @default(cuid())
  date        DateTime          @db.Date
  narration   String
  sourceType  JournalSourceType
  sourceId    String? // loose reference to the Invoice/Payment/PenaltyCharge/Expense id that caused this posting
  createdById String?
  createdAt   DateTime          @default(now())

  lines JournalLine[]

  @@index([date])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id             String         @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id])
  accountId      String
  account        ChartOfAccount @relation(fields: [accountId], references: [id])
  debit          Decimal        @default(0)
  credit         Decimal        @default(0)

  @@index([accountId])
}

model Expense {
  id                String         @id @default(cuid())
  date              DateTime       @db.Date
  accountId         String // which expense category (Chart of Accounts)
  account           ChartOfAccount @relation("ExpenseAccount", fields: [accountId], references: [id])
  paidFromAccountId String // Cash or Bank account it was paid from
  paidFromAccount   ChartOfAccount @relation("PaidFromAccount", fields: [paidFromAccountId], references: [id])
  amount            Decimal
  description       String
  vendorName        String?
  journalEntryId    String         @unique
  createdAt         DateTime       @default(now())
}

// ---------- Product master (reference/price list) ----------
//
// Distinct from Container: this is the catalog (what variants exist, current
// price), not a physical instance. Subscription.ratePerLitre is copied from
// here at order-creation time (or overridden), not looked up live, so a
// price change doesn't retroactively alter historical orders.
model Product {
  id         String   @id @default(cuid())
  externalId String   @unique
  name       String
  variant    String
  category   String
  sizeLabel  String?
  unitPrice  Decimal?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}
