PORT=4000
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
ACCESS_TOKEN_TTL=15m

# Shared with @rtcom/db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rtcom_os?schema=public"

SEED_ADMIN_PHONE=9999999999
SEED_ADMIN_PASSWORD=changeme123

# Required for WhatsApp/voice intent parsing (packages/api/src/lib/intent-parser.ts)
ANTHROPIC_API_KEY=

# Optional: when unset, outbound WhatsApp/voice replies are just logged and
# recorded in CustomerMessage instead of actually being sent (dev-safe default).
WHATSAPP_ACCESS_TOKEN=
